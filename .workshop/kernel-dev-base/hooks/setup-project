#!/usr/bin/env bash
set -euxo pipefail

# clone and build opensbi
OPENSBI_VERSION="v1.9"
OPENSBI_URL="https://github.com/riscv-software-src/opensbi.git"

echo "[*] OpenSBI version: ${OPENSBI_VERSION}"
echo "[*] OpenSBI url: ${OPENSBI_URL}"

# clone opensbi from github
if [ ! -d opensbi ]; then
  git clone \
    --depth=1 \
    --branch="${OPENSBI_VERSION}" \
    --single-branch \
    "${OPENSBI_URL}" \
    opensbi
fi

# build firmware
if [ ! -f opensbi/build/platform/generic/firmware/fw_jump.bin ]; then
  export CROSS_COMPILE=riscv64-linux-gnu-
  make -C opensbi PLATFORM=generic
fi

# install rust riscv64 core
rustup target add riscv64imac-unknown-none-elf