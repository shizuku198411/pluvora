#!/usr/bin/env bash
set -euxo pipefail

cd /project

missing=0

command -v qemu-system-riscv64 >/dev/null || missing=1
command -v clang >/dev/null || missing=1
command -v llvm-objdump >/dev/null || missing=1
command -v llvm-objcopy >/dev/null || missing=1
command -v python3 >/dev/null || missing=1

if [ ! -f opensbi/build/platform/generic/firmware/fw_jump.bin ]; then
  missing=1
fi

if [ "$missing" -eq 0 ]; then
  workshopctl set-health okay
else
  workshopctl set-health waiting "environment is still missing toolchain artifacts"
fi
